# Local development / on-prem defaults. Copy to .env and adjust.

POSTGRES_USER=mydrive
POSTGRES_PASSWORD=mydrive
POSTGRES_DB=mydrive
DATABASE_URL=postgres://mydrive:mydrive@localhost:5432/mydrive

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mydrive
MINIO_REGION=us-east-1

JWT_SECRET=change-me-in-production-please-use-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8080
# Public origins are hostnames (Nginx Proxy Manager), not raw IP:port.
# Point these at the proxy hosts you create (or the defaults the bootstrap container creates).
# For local dev, add them to /etc/hosts: 127.0.0.1 portal.localhost api.localhost s3.localhost console.localhost
PORTAL_DOMAIN=portal.localhost
API_DOMAIN=api.localhost
MINIO_DOMAIN=s3.localhost
MINIO_CONSOLE_DOMAIN=console.localhost
PORTAL_PUBLIC_URL=http://portal.localhost
API_PUBLIC_URL=http://api.localhost
MINIO_PUBLIC_URL=http://s3.localhost
MINIO_CONSOLE_PUBLIC_URL=http://console.localhost
# Where NPM forwards each hostname. Dev compose uses service DNS; prod compose overrides to 127.0.0.1.
PORTAL_UPSTREAM_HOST=web
PORTAL_UPSTREAM_PORT=80
API_UPSTREAM_HOST=api
API_UPSTREAM_PORT=8080
MINIO_UPSTREAM_HOST=minio
MINIO_UPSTREAM_PORT=9000
MINIO_CONSOLE_UPSTREAM_HOST=minio
MINIO_CONSOLE_UPSTREAM_PORT=9001
# Direct host ports kept for local debugging. Public clients should use the domains above.
PORTAL_HTTP_PORT=8088
API_HTTP_PORT=8080
# Nginx Proxy Manager admin UI is published on NPM_ADMIN_PORT (default 81).
# Initial login is NPM's own default; change it in the UI after first boot.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme
MDNS_SERVICE_NAME=my-drive
MDNS_ENABLE=true

# Watchtower (prod compose only)
WATCHTOWER_POLL_INTERVAL=300

# PrimeNG (portal). Baked into the Angular bundle at build time.
PRIMENG_LICENSE=

# Cloud imports (portal). Baked at build/serve via apps/web/scripts/ng-env.mjs.
# Google Cloud Console: OAuth Web client + Photos Picker API; Picker/Drive need an API key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Spotify Developer Dashboard: Web API app (PKCE; no client secret in the SPA).
# Redirect URI default: http://localhost:4200/imports/spotify/callback (or your portal origin).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

# musicdl-export sidecar. Compose overrides this to http://musicdl:8090 for the API container.
# Host `cargo run` uses the published loopback port. Not exposed through Nginx Proxy Manager.
MUSICDL_URL=http://127.0.0.1:8090
# Angular `ng serve` proxy only. Leave unset to keep proxy.conf.json on 127.0.0.1:8080.
# Set to API_PUBLIC_URL when the dev server should call the domain instead.
# API_PROXY_TARGET=http://api.localhost
# Comma-separated musicdl clients. Defaults match musicdl's built-in mainland sources.
MUSICDL_SOURCES=MiguMusicClient,NeteaseMusicClient,QQMusicClient,KuwoMusicClient,QianqianMusicClient
MUSICDL_SEARCH_SIZE=3
# Stop waiting for slow sources after this many seconds and return whatever already arrived.
MUSICDL_SEARCH_DEADLINE=20
