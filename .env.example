# Local development / on-prem defaults. Copy to .env and adjust.

POSTGRES_USER=mydrive
POSTGRES_PASSWORD=mydrive
POSTGRES_DB=mydrive
DATABASE_URL=postgres://mydrive:mydrive@localhost:5432/mydrive

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mydrive
MINIO_REGION=us-east-1

JWT_SECRET=change-me-in-production-please-use-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
MDNS_SERVICE_NAME=my-drive
MDNS_ENABLE=true

# Watchtower (prod compose only)
WATCHTOWER_POLL_INTERVAL=300

# PrimeNG (portal). Baked into the Angular bundle at build time.
PRIMENG_LICENSE=
